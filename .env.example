# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here

# Database Schemas
SOURCE_DB=nyc_taxi_source
WAREHOUSE_DB=nyc_taxi_warehouse
SOURCE_TABLE=yellow_taxi_trips

# File Paths (relative to project root or absolute paths)
# Supports yellow_taxi_2025.csv or 2025_Yellow_Taxi_Trip_Data_20261018.csv
RAW_CSV_PATH=2025_Yellow_Taxi_Trip_Data_20261018.csv
RAW_DATA_PATH=2025_Yellow_Taxi_Trip_Data_20261018.csv
LOOKUP_CSV_PATH=taxi_zone_lookup.csv

# ETL Performance Settings
# CHUNK_SIZE controls memory bounding: 50,000 to 100,000 is optimal for 8GB-16GB RAM machines
CHUNK_SIZE=100000
# Extraction mode: 'db' (stream from MySQL source table) or 'csv' (stream from raw flat file)
EXTRACT_MODE=db

# Logging
LOG_LEVEL=INFO
